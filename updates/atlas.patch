+window.POINTS_PYTHON_SOURCE = "#!/usr/bin/env python3\n\"\"\"Раздел фиксированного банка в матче до трёх побед. Python 3, без пакетов.\"\"\"\nimport argparse\nimport json\nfrom fractions import Fraction\n\nDEFAULT_A = 2\nDEFAULT_B = 0\nDEFAULT_STAKE = 12\n\n\ndef model(a, b, stake=12):\n    if not isinstance(a, int) or not isinstance(b, int) or not 0 <= a <= 3 or not 0 <= b <= 3 or (a == b == 3):\n        raise ValueError('Недопустимый счёт')\n    stake = Fraction(str(stake))\n    if stake < 0:\n        raise ValueError('Взнос должен быть неотрицательным')\n    paths = []\n\n    def visit(x, y, path='', weight=Fraction(1)):\n        if x == 3 or y == 3:\n            paths.append({'path': path, 'probability': weight, 'winner': 'A' if x == 3 else 'B'})\n            return\n        visit(x + 1, y, path + 'A', weight / 2)\n        visit(x, y + 1, path + 'B', weight / 2)\n\n    visit(a, b)\n    pa = sum((row['probability'] for row in paths if row['winner'] == 'A'), Fraction(0))\n    pb, bank = 1 - pa, 2 * stake\n    return {'score': [a, b], 'bank': bank, 'pA': pa, 'pB': pb,\n            'valueA': bank * pa, 'valueB': bank * pb, 'paths': paths}\n\n\ndef as_json(result):\n    return {'score': result['score'], 'bank': float(result['bank']),\n            'pA': float(result['pA']), 'pB': float(result['pB']),\n            'valueA': float(result['valueA']), 'valueB': float(result['valueB']),\n            'paths': [{'path': row['path'], 'weight': float(row['probability']), 'winner': row['winner']}\n                      for row in result['paths']]}\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('--a', type=int, default=DEFAULT_A)\n    parser.add_argument('--b', type=int, default=DEFAULT_B)\n    parser.add_argument('--stake', default=str(DEFAULT_STAKE), help='Однократный взнос каждого игрока')\n    parser.add_argument('--json', action='store_true')\n    args = parser.parse_args()\n    try:\n        result = model(args.a, args.b, args.stake)\n    except (ValueError, ZeroDivisionError) as error:\n        parser.error(str(error))\n    if args.json:\n        print(json.dumps(as_json(result), ensure_ascii=False))\n        return\n    print('До 3 побед; партии независимы, шансы 1/2; новых взносов нет.')\n    print('Счёт %d:%d; банк %s' % (args.a, args.b, result['bank']))\n    for row in result['paths']:\n        print('%-12s вероятность %-5s победитель %s' % (row['path'] or 'Уже окончен', row['probability'], row['winner']))\n    print('A: шанс %s; доля %s' % (result['pA'], result['valueA']))\n    print('B: шанс %s; доля %s' % (result['pB'], result['valueB']))\n\n\nif __name__ == '__main__':\n    main()\n";
