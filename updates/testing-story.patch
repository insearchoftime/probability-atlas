+window.TESTING_PYTHON_SOURCE = "\"\"\"Ошибки I и II рода: односторонняя проверка среднего.\n\nУчебная модель: независимые N(mu, sigma**2), sigma известна (10 г).\nH0: mu = 100 г; рассматриваемая H1: mu = 100 + shift г.\nОтвергаем H0, если Z = (Xbar - 100)/(10/sqrt(n)) > c.\nЗапуск: python3 testing_lab.py --n 100 --shift 2 --c 1.6448536269514722\nТолько стандартная библиотека Python; выводы: JSON, CSV и SVG.\n\"\"\"\n\nimport argparse\nimport csv\nimport json\nimport math\nfrom pathlib import Path\n\nDEFAULT_C = 1.6448536269514722\nDEFAULT_N = 100\nDEFAULT_SHIFT = 2\nDEFAULT_PREVALENCE = 0.1\n\n\ndef phi(x):\n    \"\"\"Функция распределения стандартной нормальной величины Φ(x).\"\"\"\n    return (1.0 + math.erf(x / math.sqrt(2))) / 2\n\n\ndef density(x):\n    return math.exp(-x * x / 2) / math.sqrt(2 * math.pi)\n\n\ndef model(c=DEFAULT_C, n=DEFAULT_N, shift=DEFAULT_SHIFT,\n          prevalence=DEFAULT_PREVALENCE):\n    if (not math.isfinite(c) or not isinstance(n, int) or n < 1\n            or not math.isfinite(shift) or shift < 0\n            or not math.isfinite(prevalence) or not 0 <= prevalence <= 1):\n        raise ValueError(\"Недопустимые параметры опыта\")\n    se = 10 / math.sqrt(n)\n    delta = shift / se\n    alpha = 1 - phi(c)\n    beta = phi(c - delta)\n    power = 1 - beta\n    counts = {\n        \"tn\": 10000 * (1 - prevalence) * (1 - alpha),\n        \"fp\": 10000 * (1 - prevalence) * alpha,\n        \"fn\": 10000 * prevalence * beta,\n        \"tp\": 10000 * prevalence * power,\n    }\n    signals = counts[\"fp\"] + counts[\"tp\"]\n    return dict(c=c, n=n, shift=shift, prevalence=prevalence,\n                mu0=100, mu1=100 + shift, sigma=10, se=se, delta=delta,\n                alpha=alpha, beta=beta, power=power,\n                thresholdMean=100 + c * se, counts=counts,\n                falseAmongSignals=counts[\"fp\"] / signals if signals else None)\n\n\ndef svg_chart(m):\n    \"\"\"Те же координаты и области, что в интерактивной карточке.\"\"\"\n    width, height, left, right, top, bottom = 760, 370, 46, 744, 32, 272\n    xmin, xmax = -4, max(5, m[\"delta\"] + 4)\n    def sx(x):\n        return left + (x - xmin) / (xmax - xmin) * (right - left)\n    def sy(y):\n        return bottom - y / .43 * (bottom - top)\n    def curve(mean, a=xmin, b=xmax):\n        return \" \".join(\n            (\"M\" if j == 0 else \"L\")\n            + f\"{sx(a+(b-a)*j/280):.2f},{sy(density(a+(b-a)*j/280-mean)):.2f}\"\n            for j in range(281))\n    def area(mean, a, b):\n        a, b = max(xmin, a), min(xmax, b)\n        if a >= b:\n            return \"\"\n        return (curve(mean, a, b)\n                + f\" L{sx(b):.2f},{bottom} L{sx(a):.2f},{bottom} Z\")\n    ticks = []\n    step = 2 if xmax - xmin > 12 else 1\n    for x in range(math.ceil(xmin / step) * step, math.floor(xmax) + 1, step):\n        ticks.append(f'<line x1=\"{sx(x)}\" x2=\"{sx(x)}\" y1=\"{bottom}\" y2=\"{bottom+6}\"/>'\n                     f'<text x=\"{sx(x)}\" y=\"{bottom+25}\" text-anchor=\"middle\">{x}</text>')\n    return f'''<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {width} {height}\" role=\"img\">\n<title>Односторонняя проверка среднего: ошибки I и II рода</title>\n<style>text{{font:14px system-ui;fill:#302e2a}}line{{stroke:#8a8478}}.curve{{fill:none;stroke-width:2.5}}</style>\n<rect width=\"100%\" height=\"100%\" fill=\"#f7f4ec\"/>\n<rect x=\"{sx(m['c'])}\" y=\"{top}\" width=\"{right-sx(m['c'])}\" height=\"{bottom-top}\" fill=\"#ece7dc\"/>\n<path d=\"{area(m['delta'],xmin,m['c'])}\" fill=\"#638f914a\"/>\n<path d=\"{area(0,m['c'],xmax)}\" fill=\"#af695354\"/>\n<path class=\"curve\" d=\"{curve(0)}\" stroke=\"#ad6550\"/>\n<path class=\"curve\" d=\"{curve(m['delta'])}\" stroke=\"#3e777b\"/>\n<line x1=\"{left}\" x2=\"{right}\" y1=\"{bottom}\" y2=\"{bottom}\"/>{''.join(ticks)}\n<line x1=\"{sx(m['c'])}\" x2=\"{sx(m['c'])}\" y1=\"{top-4}\" y2=\"{bottom+8}\" stroke-dasharray=\"5 4\"/>\n<text x=\"{sx(m['c'])}\" y=\"{top-12}\" text-anchor=\"middle\">c = {m['c']:.3f}</text>\n<text x=\"{(left+right)/2}\" y=\"{bottom+57}\" text-anchor=\"middle\">Z = (среднее − 100 г) / (10 г / √n)</text>\n<text x=\"{(left+right)/2}\" y=\"{bottom+83}\" text-anchor=\"middle\">H₀: Z ~ N(0, 1); H₁: Z ~ N({m['delta']:.2f}, 1)</text></svg>'''\n\n\ndef export(m, directory):\n    directory = Path(directory)\n    directory.mkdir(parents=True, exist_ok=True)\n    (directory / \"testing_results.json\").write_text(\n        json.dumps(m, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n    with (directory / \"testing_densities.csv\").open(\"w\", newline=\"\", encoding=\"utf-8\") as stream:\n        writer = csv.writer(stream)\n        writer.writerow([\"z\", \"density_h0\", \"density_h1\", \"reject_h0\"])\n        xmin, xmax = -4, max(5, m[\"delta\"] + 4)\n        for j in range(801):\n            x = xmin + (xmax - xmin) * j / 800\n            writer.writerow([x, density(x), density(x - m[\"delta\"]), x > m[\"c\"]])\n    (directory / \"testing_chart.svg\").write_text(svg_chart(m), encoding=\"utf-8\")\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--c\", type=float, default=DEFAULT_C)\n    parser.add_argument(\"--n\", type=int, default=DEFAULT_N)\n    parser.add_argument(\"--shift\", type=float, default=DEFAULT_SHIFT)\n    parser.add_argument(\"--prevalence\", type=float, default=DEFAULT_PREVALENCE)\n    parser.add_argument(\"--output\", default=\"testing_output\")\n    args = parser.parse_args()\n    m = model(args.c, args.n, args.shift, args.prevalence)\n    export(m, args.output)\n    print(json.dumps(m, ensure_ascii=False, indent=2))\n    print(\"Файлы сохранены:\", Path(args.output).resolve())\n\n\nif __name__ == \"__main__\":\n    main()\n";
