-window.PLOT_PYTHON_SOURCE = "#!/usr/bin/env python3\n\"\"\"Воспроизводимые числовые модели всех 25 графиков локального атласа.\n\nТолько стандартная библиотека Python 3.8+. Все графики — современные\nучебные реконструкции, а не изображения из исторических публикаций.\nЗапуск: python3 visual_experiments.py --idea galton --value 16 --out galton\nРезультат: galton.csv, galton.json, galton.svg. Без --out печатается JSON.\nРаспределения и параметры повторяют visuals.js; renderer намеренно простой.\n\"\"\"\n\nDEFAULT_ID = 'galton'\nDEFAULT_VALUE = 16\nDEFAULT_SEED = 42\nDEFAULT_HEADS = 0\nDEFAULT_TAILS = 0\nDEFAULT_MODE = 'A'\n\nimport argparse\nimport csv\nimport html\nimport json\nimport math\nfrom pathlib import Path\n\n\nCONFIGS = {\n    'chance': ('grid', None, None, None, 'Одна сумма — разные пути'),\n    'independence': ('independent', None, None, None, 'Монета не помнит предыдущий бросок'),\n    'combinations': ('binomial', 4, 2, 12, 'Сколько путей ведёт в ячейку?'),\n    'binomial': ('binomial', 12, 1, 60, 'От отдельных шагов к распределению'),\n    'pascal-fermat': ('tree', None, None, None, 'Четыре продолжения незавершённой игры'),\n    'huygens': ('expectation', None, None, None, 'Ожидание не обязано быть исходом'),\n    'graunt': ('denominator', 2000, 200, 4000, 'Число случаев и частота — разные вопросы'),\n    'bernoulli': ('lln', 500, 20, 2000, 'Частоты учатся говорить о вероятности'),\n    'de-moivre': ('binomial', 12, 1, 60, 'Биномиальные столбики и нормальное приближение'),\n    'bayes': ('beta', None, None, None, 'Как данные меняют распределение шанса'),\n    'legendre': ('regression', 10, -10, 30, 'Остатки, которые хочется сделать меньше'),\n    'gauss': ('normal', 10, 3, 25, 'Один центр, разный разброс'),\n    'laplace': ('dice', 1, 1, 12, 'Сумма всё меньше похожа на одно слагаемое'),\n    'poisson': ('poisson', 3, 1, 12, 'Ожидаемое число редких событий'),\n    'galton': ('binomial', 16, 1, 60, 'Число рядов меняет закон'),\n    'regression': ('reversion', 20, -30, 30, 'Крайние значения и условное среднее'),\n    'pearson': ('chi', 10, 0, 10, 'Сумма взвешенных отклонений'),\n    'student': ('student', 3, 1, 40, 'Неизвестный разброс делает хвосты тяжелее'),\n    'fisher': ('likelihood', 7, 0, 10, 'Что эти данные говорят о параметре?'),\n    'neyman-pearson': ('testing', 16, -10, 40, 'Одна граница — два вида ошибок'),\n    'kolmogorov': ('grid', None, None, None, 'События — множества, вероятность — мера'),\n    'neyman': ('intervals', None, None, None, '95% относится к повторяемой процедуре'),\n    'sample-mean': ('mean', 10, 1, 100, 'Почему среднее стабильнее одного измерения'),\n    'measurements': ('sumerrors', 5, 1, 16, 'Независимые ошибки складывают дисперсии'),\n    'ab-testing': ('ab', 140, 80, 200, 'Разность долей и её неопределённость'),\n}\n\n\nclass XorShift32:\n    \"\"\"Те же беззнаковые 32-битные биты и шаги, что JS rng(seed).\"\"\"\n\n    def __init__(self, seed=42):\n        self.state = seed or 1\n\n    def __call__(self):\n        x = self.state\n        x ^= (x << 13) & 0xffffffff\n        x ^= x >> 17\n        x ^= (x << 5) & 0xffffffff\n        self.state = x & 0xffffffff\n        return self.state / 4294967296\n\n\ndef gaussian(random):\n    # Два новых draw на каждый вызов: spare-variate не кэшируется.\n    return math.sqrt(-2 * math.log(max(1e-12, random()))) * math.cos(2 * math.pi * random())\n\n\ndef phi(z):\n    \"\"\"Та же аппроксимация erf, что браузер (ошибка порядка 1e-7).\"\"\"\n    sign = -1 if z < 0 else 1\n    x = abs(z) / math.sqrt(2)\n    t = 1 / (1 + .3275911 * x)\n    erf = 1 - (((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t\n                 - .284496736) * t + .254829592) * t) * math.exp(-x * x)\n    return .5 * (1 + sign * erf)\n\n\ndef log_gamma(z):\n    \"\"\"Lanczos с теми же коэффициентами, что visuals.js.\"\"\"\n    c = [676.5203681218851, -1259.1392167224028, 771.32342877765313,\n         -176.61502916214059, 12.507343278686905, -.13857109526572012,\n         9.984369578019572e-6, 1.5056327351493116e-7]\n    if z < .5:\n        return math.log(math.pi) - math.log(math.sin(math.pi * z)) - log_gamma(1 - z)\n    z -= 1\n    x = .99999999999980993\n    for i, coefficient in enumerate(c):\n        x += coefficient / (z + i + 1)\n    t = z + len(c) - .5\n    return .5 * math.log(2 * math.pi) + (z + .5) * math.log(t) - t + math.log(x)\n\n\ndef normal(x, mean=0, sd=1):\n    return math.exp(-.5 * ((x - mean) / sd) ** 2) / (sd * math.sqrt(2 * math.pi))\n\n\ndef binomial(n, p=.5):\n    combination = 1.0\n    values = []\n    for k in range(n + 1):\n        values.append(combination * p ** k * (1 - p) ** (n - k))\n        combination *= (n - k) / (k + 1)\n    return values\n\n\ndef normal_mass(n, p=.5):\n    mean, sd = n * p, math.sqrt(n * p * (1 - p))\n    return [max(0, phi((k + .5 - mean) / sd) - phi((k - .5 - mean) / sd))\n            for k in range(n + 1)]\n\n\ndef wilson(successes, n=30, z=1.96):\n    ph = successes / n\n    denominator = 1 + z * z / n\n    center = (ph + z * z / (2 * n)) / denominator\n    half = z * math.sqrt(ph * (1 - ph) / n + z * z / (4 * n * n)) / denominator\n    return center - half, center + half\n\n\ndef series(name, points, style='line', color=None):\n    result = {'name': name, 'style': style, 'points': [[x, y] for x, y in points]}\n    if color:\n        result['color'] = color\n    return result\n\n\ndef validate(idea, value, seed, heads, tails, mode):\n    if idea not in CONFIGS:\n        raise ValueError('Неизвестная идея: ' + idea)\n    kind, default, minimum, maximum, _ = CONFIGS[idea]\n    if value is None:\n        value = default\n    if minimum is not None:\n        if value is None or not math.isfinite(value) or value != int(value):\n            raise ValueError('--value должен быть целым значением ползунка')\n        if not minimum <= value <= maximum:\n            raise ValueError('--value для %s: от %s до %s' % (idea, minimum, maximum))\n        value = int(value)\n    if not 0 <= seed <= 0xffffffff:\n        raise ValueError('--seed должен быть uint32: 0…4294967295')\n    if heads < 0 or tails < 0:\n        raise ValueError('--heads и --tails должны быть неотрицательными')\n    if heads + tails > 100000:\n        raise ValueError('Для учебного графика используйте не более 100000 исходов')\n    allowed = {'grid': ('A', 'B', 'intersection', 'union'),\n               'tree': ('A', 'AA', 'AB', 'BA', 'BB'),\n               'independent': ('A', 'coin', 'bag')}\n    if kind in allowed and mode not in allowed[kind]:\n        raise ValueError('--mode: ' + ', '.join(allowed[kind]))\n    return value\n\n\ndef model(idea, value=None, seed=42, heads=0, tails=0, mode='A'):\n    value = validate(idea, value, seed, heads, tails, mode)\n    kind, _, _, _, title = CONFIGS[idea]\n    result = {'idea': idea, 'kind': kind, 'title': title,\n              'parameters': {'value': value, 'seed': seed, 'heads': heads, 'tails': tails, 'mode': mode},\n              'metrics': {}, 'series': [], 'rows': [],\n              'note': 'Современная учебная реконструкция. Условия вероятностной модели существенны.'}\n    metrics, curves, rows = result['metrics'], result['series'], result['rows']\n\n    if kind == 'binomial':\n        values = binomial(value)\n        approximation = normal_mass(value) if idea in ('de-moivre', 'galton') else None\n        curves.append(series('Биномиальная вероятность', enumerate(values), 'bar'))\n        if approximation:\n            curves.append(series('Нормальная масса k±0,5', enumerate(approximation), color='#bc8754'))\n        for k, probability in enumerate(values):\n            row = {'k': k, 'probability': probability, 'paths': math.comb(value, k)}\n            if approximation:\n                row['normal_mass'] = approximation[k]\n            rows.append(row)\n        metrics.update(n=value, p=.5, mean=value / 2, variance=value / 4,\n                       total_probability=sum(values), total_paths=2 ** value,\n                       largest_path_count=math.comb(value, value // 2))\n        if approximation:\n            metrics['normal_mass_total_on_bins'] = sum(approximation)\n    elif kind == 'grid':\n        count = 0\n        for a in range(1, 7):\n            for b in range(1, 7):\n                event_a, event_b = a + b == 7, a % 2 == 0\n                selected = {'A': event_a, 'B': event_b, 'intersection': event_a and event_b,\n                            'union': event_a or event_b}[mode]\n                count += selected\n                rows.append({'a': a, 'b': b, 'A': event_a, 'B': event_b,\n                             'selected': selected, 'probability': 1 / 36})\n        metrics.update(selected_outcomes=count, all_outcomes=36, probability=count / 36)\n    elif kind == 'tree':\n        for path in ('AA', 'AB', 'BA', 'BB'):\n            rows.append({'path': path, 'winner': 'B' if path == 'BB' else 'A',\n                         'probability': .25, 'selected': path == mode})\n        curves.append(series('Вес продолжения', [(i, .25) for i in range(4)], 'bar'))\n        metrics.update(A_wins=.75, B_wins=.25, fair_share_ratio='3:1', selected_path=mode if len(mode) == 2 else None)\n    elif kind == 'expectation':\n        for i, payout in enumerate((0, 3, 12)):\n            rows.append({'outcome': i, 'payout': payout, 'probability': 1 / 3})\n        curves.extend([series('Выплата', enumerate((0, 3, 12)), 'bar'),\n                       series('Средняя выплата', [(-.5, 5), (2.5, 5)], color='#bc8754')])\n        metrics['expectation'] = 5\n    elif kind == 'denominator':\n        rows.extend([{'district': 'A', 'cases': 20, 'population': 200, 'rate': .1},\n                     {'district': 'B', 'cases': 20, 'population': value, 'rate': 20 / value}])\n        curves.append(series('Доля случаев', [(0, .1), (1, 20 / value)], 'bar'))\n        metrics.update(rate_A=.1, rate_B=20 / value)\n    elif kind == 'independent':\n        after = 0 if mode == 'bag' else .5\n        rows.extend([{'condition': 'before', 'probability': .5}, {'condition': 'after', 'probability': after}])\n        curves.append(series('Шанс второго красного / орла', [(0, .5), (1, after)], 'bar'))\n        metrics.update(before=.5, after=after, independent=mode != 'bag')\n    elif kind == 'lln':\n        random, count = XorShift32(seed), 0\n        for n in range(1, value + 1):\n            count += random() < .5\n            rows.append({'trial': n, 'heads': count, 'frequency': count / n})\n        curves.extend([series('Наблюдаемая частота', [(r['trial'], r['frequency']) for r in rows]),\n                       series('Вероятность', [(1, .5), (value, .5)], color='#bc8754')])\n        metrics.update(heads=count, trials=value, frequency=count / value)\n    elif kind == 'beta':\n        a, b = heads + 1, tails + 1\n        log_b = log_gamma(a) + log_gamma(b) - log_gamma(a + b)\n        points = []\n        for j in range(201):\n            theta = j / 200\n            # Браузер клипует вычислительную точку до .0001/.9999.\n            evaluated_theta = max(.0001, min(.9999, theta))\n            density = math.exp((a - 1) * math.log(evaluated_theta) + (b - 1) * math.log(1 - evaluated_theta) - log_b)\n            points.append((theta, density))\n            rows.append({'theta': theta, 'evaluation_theta': evaluated_theta, 'density': density})\n        mean = a / (a + b)\n        curves.extend([series('Плотность Beta', points),\n                       series('Среднее θ', [(mean, 0), (mean, max(y for _, y in points))], color='#bc8754')])\n        metrics.update(a=a, b=b, mean=mean)\n        result['note'] += ' Плотность в концах вычислена в .0001/.9999, как в браузере.'\n    elif kind in ('normal', 'student', 'mean', 'sumerrors'):\n        sd = value / 10 if kind == 'normal' else 1 / math.sqrt(value) if kind == 'mean' else math.sqrt(value) if kind == 'sumerrors' else 1\n        xmin = -10 if kind == 'sumerrors' else -3 if kind == 'mean' else -5\n        norm = [(xmin + (-2 * xmin) * j / 180, normal(xmin + (-2 * xmin) * j / 180, sd=sd)) for j in range(181)]\n        points = norm\n        if kind == 'student':\n            nu = value\n            constant = math.exp(log_gamma((nu + 1) / 2) - log_gamma(nu / 2)) / math.sqrt(nu * math.pi)\n            points = [(x, constant * (1 + x * x / nu) ** (-(nu + 1) / 2)) for x, _ in norm]\n            curves.append(series('Стандартная нормальная', norm, color='#bc8754'))\n            metrics['degrees_of_freedom'] = nu\n        elif kind == 'sumerrors':\n            curves.append(series('Один источник', [(x, normal(x)) for x, _ in norm], color='#bc8754'))\n        curves.insert(0, series('Плотность t' if kind == 'student' else 'Нормальная плотность', points))\n        for j, (x, density) in enumerate(points):\n            row = {'x': x, 'density': density}\n            if kind == 'student':\n                row['normal_density'] = norm[j][1]\n            elif kind == 'sumerrors':\n                row['single_error_density'] = normal(x)\n            rows.append(row)\n        if kind != 'student':\n            metrics.update(mean=0, sd=sd, variance=sd ** 2)\n    elif kind == 'dice':\n        values = [1.0]\n        for _ in range(value):\n            next_values = [0.0] * (len(values) + 5)\n            for i, probability in enumerate(values):\n                for face in range(6):\n                    next_values[i + face] += probability / 6\n            values = next_values\n        points = [(k + value, probability) for k, probability in enumerate(values)]\n        curves.append(series('Точная вероятность суммы', points, 'bar'))\n        rows.extend({'sum': k, 'probability': probability} for k, probability in points)\n        metrics.update(dice=value, mean=value * 3.5, variance=value * 35 / 12, total_probability=sum(values))\n    elif kind == 'poisson':\n        probability, values = math.exp(-value), []\n        for k in range(max(15, value + 15) + 1):\n            values.append((k, probability))\n            probability *= value / (k + 1)\n        curves.append(series('Пуассоновская вероятность', values, 'bar'))\n        rows.extend({'k': k, 'probability': probability} for k, probability in values)\n        metrics.update(mean=value, variance=value, displayed_probability=sum(p for _, p in values))\n    elif kind == 'regression':\n        points = [(0, 1), (1, 2), (2, 2), (3, 5), (4, 4)]\n        slope, intercept = value / 10, 2.8 - 2 * value / 10\n        for x, y in points:\n            fit = intercept + slope * x\n            rows.append({'x': x, 'y': y, 'fitted': fit, 'residual': y - fit, 'squared_residual': (y - fit) ** 2})\n            curves.append(series('Остаток', [(x, y), (x, fit)], color='#bc8754'))\n        curves.extend([series('Измерения', points, 'scatter'),\n                       series('Выбранная линия', [(0, intercept), (4, intercept + 4 * slope)])])\n        metrics.update(slope=slope, intercept=intercept, sse=sum(r['squared_residual'] for r in rows), optimal_slope=.9)\n    elif kind == 'reversion':\n        # visuals.js фиксирует rng(42), даже если у соседних графиков меняют seed.\n        random = XorShift32(42)\n        points = []\n        for j in range(100):\n            x = gaussian(random)\n            y = .5 * x + math.sqrt(.75) * gaussian(random)\n            points.append((x, y))\n            rows.append({'index': j, 'x': x, 'y': y})\n        x = value / 10\n        curves.extend([series('Измерения', points, 'scatter'),\n                       series('Условное среднее', [(-3, -1.5), (3, 1.5)]),\n                       series('Выбранный X', [(x, .5 * x)], 'scatter', '#bc8754')])\n        metrics.update(correlation=.5, selected_x=x, conditional_mean=.5 * x, scatter_seed=42)\n    elif kind == 'chi':\n        base = [9, 15, 10, 16, 7, 3]\n        # Math.round для неотрицательных O: floor(x+.5), не Python round.\n        observed = [math.floor(10 + (v - 10) * value / 10 + .5) for v in base]\n        observed[5] += 60 - sum(observed)\n        for j, count in enumerate(observed):\n            rows.append({'category': j, 'observed': count, 'expected': 10, 'chi_contribution': (count - 10) ** 2 / 10})\n        curves.extend([series('Наблюдения', enumerate(observed), 'bar'),\n                       series('Ожидание', [(-.5, 10), (5.5, 10)], color='#bc8754')])\n        metrics.update(total=sum(observed), chi_square=sum(r['chi_contribution'] for r in rows))\n    elif kind == 'likelihood':\n        peak = value / 10\n        def likelihood(theta):\n            return theta ** value * (1 - theta) ** (10 - value)\n        maximum = likelihood(peak)\n        points = [(j / 200, likelihood(j / 200) / maximum) for j in range(201)]\n        curves.append(series('Относительное правдоподобие', points))\n        rows.extend({'theta': theta, 'relative_likelihood': like} for theta, like in points)\n        metrics.update(successes=value, n=10, mle=peak, maximum_without_binomial_coefficient=maximum)\n    elif kind == 'testing':\n        threshold = value / 10\n        a = [(-3 + 8 * j / 180, normal(-3 + 8 * j / 180)) for j in range(181)]\n        b = [(x, normal(x, 2)) for x, _ in a]\n        curves.extend([series('H₀: N(0,1)', a), series('H₁: N(2,1)', b, color='#bc8754'),\n                       series('Порог отказа', [(threshold, 0), (threshold, .43)], color='#596575')])\n        rows.extend({'x': x, 'H0_density': y, 'H1_density': b[j][1], 'reject_H0': x > threshold} for j, (x, y) in enumerate(a))\n        metrics.update(threshold=threshold, alpha=1 - phi(threshold), beta=phi(threshold - 2), power=1 - phi(threshold - 2))\n    elif kind == 'intervals':\n        random, covered = XorShift32(seed), 0\n        for j in range(20):\n            count = sum(random() < .5 for _ in range(30))\n            lower, upper = wilson(count)\n            covers = lower <= .5 <= upper\n            covered += covers\n            rows.append({'sample': j + 1, 'successes': count, 'n': 30, 'lower': lower, 'upper': upper, 'covers': covers})\n            curves.append(series('Выборка %s' % (j + 1), [(lower, 20 - j), (upper, 20 - j)], color='#3470a6' if covers else '#bc8754'))\n        curves.append(series('Истинное p=.5', [(.5, 0), (.5, 21)], color='#8994a4'))\n        metrics.update(true_p=.5, samples=20, n=30, covered=covered, observed_coverage=covered / 20, nominal=.95, z=1.96, procedure='Wilson')\n        result['note'] += ' Интервалы Уилсона — современная приближённая иллюстрация покрытия; серия из 20 не обязана дать 95%.'\n    elif kind == 'ab':\n        p_a, p_b = .12, value / 1000\n        difference = p_b - p_a\n        se = math.sqrt(p_a * (1 - p_a) / 1000 + p_b * (1 - p_b) / 1000)\n        lower, upper = difference - 1.96 * se, difference + 1.96 * se\n        curves.extend([series('Приближённый 95%-интервал', [(lower, .5), (upper, .5)]),\n                       series('Оценка разности', [(difference, .5)], 'scatter', '#bc8754'),\n                       series('Нулевая разность', [(0, 0), (0, 1)], color='#8994a4')])\n        rows.append({'n_A': 1000, 'successes_A': 120, 'n_B': 1000, 'successes_B': value,\n                     'p_A': p_a, 'p_B': p_b, 'difference': difference, 'standard_error': se, 'lower': lower, 'upper': upper})\n        metrics.update(rows[0])\n    else:\n        raise ValueError('Нереализованная модель: ' + kind)\n    return result\n\n\ndef render_svg(result):\n    \"\"\"Самостоятельный SVG: числовые оси, линии/столбцы/точки; сетка исходов.\"\"\"\n    width, height, left, right, top, bottom = 900, 520, 80, 850, 85, 440\n    esc = lambda text: html.escape(str(text), quote=True)\n    elements = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"520\" viewBox=\"0 0 900 520\">',\n                '<rect width=\"900\" height=\"520\" fill=\"#f8fafc\"/>',\n                '<g font-family=\"Arial,sans-serif\" fill=\"#223245\">',\n                '<text x=\"32\" y=\"34\" font-size=\"20\">%s</text>' % esc(result['title']),\n                '<text x=\"32\" y=\"58\" font-size=\"12\">%s · Современная учебная реконструкция</text>' % esc(result['idea'])]\n    if result['kind'] == 'grid':\n        for row in result['rows']:\n            x, y = 205 + (row['b'] - 1) * 75, 85 + (row['a'] - 1) * 55\n            fill = '#a3c9f4' if row['selected'] else '#e8edf3'\n            elements.extend(['<rect x=\"%s\" y=\"%s\" width=\"70\" height=\"50\" rx=\"4\" fill=\"%s\"/>' % (x, y, fill),\n                             '<text x=\"%s\" y=\"%s\" text-anchor=\"middle\" font-size=\"15\">%s, %s</text>' % (x + 35, y + 30, row['a'], row['b'])])\n        metrics = result['metrics']\n        elements.append('<text x=\"205\" y=\"455\" font-size=\"15\">%s из 36; P = %.6g</text>' % (metrics['selected_outcomes'], metrics['probability']))\n    else:\n        all_points = [point for curve in result['series'] for point in curve['points']]\n        xs, ys = [p[0] for p in all_points], [p[1] for p in all_points]\n        xmin, xmax = min(xs), max(xs)\n        ymin, ymax = min(0, min(ys)), max(ys)\n        if any(c['style'] == 'bar' for c in result['series']):\n            xmin, xmax = xmin - .5, xmax + .5\n        if xmin == xmax:\n            xmin, xmax = xmin - 1, xmax + 1\n        if ymin == ymax:\n            ymax = ymin + 1\n        margin = (ymax - ymin) * .08\n        ymin, ymax = ymin - margin if ymin < 0 else ymin, ymax + margin\n        X = lambda x: left + (x - xmin) / (xmax - xmin) * (right - left)\n        Y = lambda y: bottom - (y - ymin) / (ymax - ymin) * (bottom - top)\n        for tick in range(5):\n            x, y = xmin + (xmax - xmin) * tick / 4, ymin + (ymax - ymin) * tick / 4\n            elements.extend(['<line x1=\"%g\" y1=\"%g\" x2=\"%g\" y2=\"%g\" stroke=\"#dfe5ec\"/>' % (left, Y(y), right, Y(y)),\n                             '<text x=\"%g\" y=\"%g\" font-size=\"11\" text-anchor=\"end\">%.4g</text>' % (left - 8, Y(y) + 4, y),\n                             '<text x=\"%g\" y=\"%g\" font-size=\"11\" text-anchor=\"middle\">%.4g</text>' % (X(x), bottom + 22, x)])\n        for curve in result['series']:\n            color = curve.get('color', '#3470a6')\n            points = curve['points']\n            if curve['style'] == 'bar':\n                bar_width = min(55, .7 * (right - left) / max(1, len(points)))\n                for x, y in points:\n                    elements.append('<rect x=\"%g\" y=\"%g\" width=\"%g\" height=\"%g\" fill=\"%s\" opacity=\".6\"/>' % (X(x) - bar_width / 2, min(Y(y), Y(0)), bar_width, abs(Y(0) - Y(y)), color))\n            elif curve['style'] == 'scatter':\n                for x, y in points:\n                    elements.append('<circle cx=\"%g\" cy=\"%g\" r=\"3\" fill=\"%s\" opacity=\".75\"/>' % (X(x), Y(y), color))\n            else:\n                coordinates = ' '.join('%g,%g' % (X(x), Y(y)) for x, y in points)\n                elements.append('<polyline points=\"%s\" fill=\"none\" stroke=\"%s\" stroke-width=\"2\"/>' % (coordinates, color))\n        unique = list(dict.fromkeys(c['name'] for c in result['series'] if not c['name'].startswith('Выборка ')))\n        legend = ' · '.join(unique)\n        elements.append('<text x=\"80\" y=\"490\" font-size=\"12\">%s</text>' % esc(legend[:125]))\n    elements.extend(['</g>', '</svg>'])\n    return '\\n'.join(elements) + '\\n'\n\n\ndef export(result, prefix):\n    prefix = Path(prefix)\n    prefix.parent.mkdir(parents=True, exist_ok=True)\n    paths = [Path(str(prefix) + extension) for extension in ('.csv', '.json', '.svg')]\n    fields = list(dict.fromkeys(field for row in result['rows'] for field in row))\n    with paths[0].open('w', newline='', encoding='utf-8') as stream:\n        writer = csv.DictWriter(stream, fieldnames=fields)\n        writer.writeheader()\n        writer.writerows(result['rows'])\n    paths[1].write_text(json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False) + '\\n', encoding='utf-8')\n    paths[2].write_text(render_svg(result), encoding='utf-8')\n    return paths\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    parser.add_argument('--idea', choices=CONFIGS, default=DEFAULT_ID)\n    parser.add_argument('--value', type=float, default=None, help='Целое значение ползунка выбранной карточки')\n    parser.add_argument('--seed', type=int, default=DEFAULT_SEED, help='Беззнаковое uint32; 0 даёт ту же последовательность, что 1')\n    parser.add_argument('--heads', type=int, default=DEFAULT_HEADS)\n    parser.add_argument('--tails', type=int, default=DEFAULT_TAILS)\n    parser.add_argument('--mode', default=DEFAULT_MODE, help='A/B/intersection/union; AA/AB/BA/BB; coin/bag')\n    parser.add_argument('--out', type=str, help='Префикс файлов CSV, JSON и SVG, например work/galton')\n    parser.add_argument('--list', action='store_true', help='Перечислить идеи и значения по умолчанию')\n    args = parser.parse_args()\n    if args.list:\n        for idea, (kind, value, minimum, maximum, title) in CONFIGS.items():\n            print('%s: %s; value=%s; bounds=%s…%s — %s' % (idea, kind, value, minimum, maximum, title))\n        return\n    value = args.value\n    if value is None and args.idea == DEFAULT_ID:\n        value = DEFAULT_VALUE\n    try:\n        result = model(args.idea, value, args.seed, args.heads, args.tails, args.mode)\n        if args.out:\n            for path in export(result, args.out):\n                print(path.resolve())\n            print(json.dumps(result['metrics'], ensure_ascii=False, indent=2, allow_nan=False))\n        else:\n            print(json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False))\n    except (ValueError, OverflowError, OSError) as error:\n        parser.error(str(error))\n\n\nif __name__ == '__main__':\n    main()\n";
+window.PLOT_PYTHON_SOURCE = "#!/usr/bin/env python3\n\"\"\"Воспроизводимые числовые модели всех 25 графиков локального атласа.\n\nТолько стандартная библиотека Python 3.8+. Все графики — современные\nучебные реконструкции, а не изображения из исторических публикаций.\nЗапуск: python3 visual_experiments.py --idea galton --value 16 --out galton\nРезультат: galton.csv, galton.json, galton.svg. Без --out печатается JSON.\nРаспределения и параметры повторяют visuals.js; renderer намеренно простой.\n\"\"\"\n\nDEFAULT_ID = 'galton'\nDEFAULT_VALUE = 16\nDEFAULT_SEED = 42\nDEFAULT_HEADS = 0\nDEFAULT_TAILS = 0\nDEFAULT_MODE = 'A'\n\nimport argparse\nimport csv\nimport html\nimport json\nimport math\nfrom pathlib import Path\n\n\nCONFIGS = {\n    'chance': ('grid', None, None, None, 'Одна сумма — разные пути'),\n    'independence': ('independent', None, None, None, 'Монета не помнит предыдущий бросок'),\n    'combinations': ('binomial', 4, 2, 12, 'Сколько путей ведёт в ячейку?'),\n    'binomial': ('binomial', 12, 1, 60, 'От отдельных шагов к распределению'),\n    'pascal-fermat': ('tree', None, None, None, 'Четыре продолжения незавершённой игры'),\n    'huygens': ('expectation', None, None, None, 'Ожидание не обязано быть исходом'),\n    'graunt': ('denominator', 2000, 200, 4000, 'Число случаев и частота — разные вопросы'),\n    'bernoulli': ('lln', 500, 20, 2000, 'Частоты учатся говорить о вероятности'),\n    'de-moivre': ('binomial', 12, 1, 60, 'Биномиальные столбики и нормальное приближение'),\n    'bayes': ('beta', None, None, None, 'Как данные меняют распределение шанса'),\n    'legendre': ('regression', 10, -10, 30, 'Остатки, которые хочется сделать меньше'),\n    'gauss': ('normal', 10, 3, 25, 'Один центр, разный разброс'),\n    'laplace': ('dice', 1, 1, 12, 'Сумма всё меньше похожа на одно слагаемое'),\n    'poisson': ('poisson', 3, 1, 12, 'Ожидаемое число редких событий'),\n    'galton': ('binomial', 16, 1, 60, 'Число рядов меняет закон'),\n    'regression': ('reversion', 20, -30, 30, 'Крайние значения и условное среднее'),\n    'pearson': ('chi', 10, 0, 10, 'Сумма взвешенных отклонений'),\n    'student': ('student', 3, 1, 40, 'Неизвестный разброс делает хвосты тяжелее'),\n    'fisher': ('likelihood', 7, 0, 10, 'Что эти данные говорят о параметре?'),\n    'neyman-pearson': ('testing', 16, -10, 40, 'Одна граница — два вида ошибок'),\n    'kolmogorov': ('grid', None, None, None, 'События — множества, вероятность — мера'),\n    'neyman': ('intervals', None, None, None, '95% относится к повторяемой процедуре'),\n    'sample-mean': ('mean', 10, 1, 100, 'Почему среднее стабильнее одного измерения'),\n    'measurements': ('sumerrors', 5, 1, 16, 'Независимые ошибки складывают дисперсии'),\n    'ab-testing': ('ab', 140, 80, 200, 'Разность долей и её неопределённость'),\n}\n\n\nclass XorShift32:\n    \"\"\"Те же беззнаковые 32-битные биты и шаги, что JS rng(seed).\"\"\"\n\n    def __init__(self, seed=42):\n        self.state = seed or 1\n\n    def __call__(self):\n        x = self.state\n        x ^= (x << 13) & 0xffffffff\n        x ^= x >> 17\n        x ^= (x << 5) & 0xffffffff\n        self.state = x & 0xffffffff\n        return self.state / 4294967296\n\n\ndef gaussian(random):\n    # Два новых draw на каждый вызов: spare-variate не кэшируется.\n    return math.sqrt(-2 * math.log(max(1e-12, random()))) * math.cos(2 * math.pi * random())\n\n\ndef phi(z):\n    \"\"\"Та же аппроксимация erf, что браузер (ошибка порядка 1e-7).\"\"\"\n    sign = -1 if z < 0 else 1\n    x = abs(z) / math.sqrt(2)\n    t = 1 / (1 + .3275911 * x)\n    erf = 1 - (((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t\n                 - .284496736) * t + .254829592) * t) * math.exp(-x * x)\n    return .5 * (1 + sign * erf)\n\n\ndef log_gamma(z):\n    \"\"\"Lanczos с теми же коэффициентами, что visuals.js.\"\"\"\n    c = [676.5203681218851, -1259.1392167224028, 771.32342877765313,\n         -176.61502916214059, 12.507343278686905, -.13857109526572012,\n         9.984369578019572e-6, 1.5056327351493116e-7]\n    if z < .5:\n        return math.log(math.pi) - math.log(math.sin(math.pi * z)) - log_gamma(1 - z)\n    z -= 1\n    x = .99999999999980993\n    for i, coefficient in enumerate(c):\n        x += coefficient / (z + i + 1)\n    t = z + len(c) - .5\n    return .5 * math.log(2 * math.pi) + (z + .5) * math.log(t) - t + math.log(x)\n\n\ndef normal(x, mean=0, sd=1):\n    return math.exp(-.5 * ((x - mean) / sd) ** 2) / (sd * math.sqrt(2 * math.pi))\n\n\ndef binomial(n, p=.5):\n    combination = 1.0\n    values = []\n    for k in range(n + 1):\n        values.append(combination * p ** k * (1 - p) ** (n - k))\n        combination *= (n - k) / (k + 1)\n    return values\n\n\ndef normal_mass(n, p=.5):\n    mean, sd = n * p, math.sqrt(n * p * (1 - p))\n    return [max(0, phi((k + .5 - mean) / sd) - phi((k - .5 - mean) / sd))\n            for k in range(n + 1)]\n\n\ndef wilson(successes, n=30, z=1.96):\n    ph = successes / n\n    denominator = 1 + z * z / n\n    center = (ph + z * z / (2 * n)) / denominator\n    half = z * math.sqrt(ph * (1 - ph) / n + z * z / (4 * n * n)) / denominator\n    return center - half, center + half\n\n\ndef series(name, points, style='line', color=None):\n    result = {'name': name, 'style': style, 'points': [[x, y] for x, y in points]}\n    if color:\n        result['color'] = color\n    return result\n\n\ndef validate(idea, value, seed, heads, tails, mode):\n    if idea not in CONFIGS:\n        raise ValueError('Неизвестная идея: ' + idea)\n    kind, default, minimum, maximum, _ = CONFIGS[idea]\n    if value is None:\n        value = default\n    if minimum is not None:\n        if value is None or not math.isfinite(value) or value != int(value):\n            raise ValueError('--value должен быть целым значением ползунка')\n        if not minimum <= value <= maximum:\n            raise ValueError('--value для %s: от %s до %s' % (idea, minimum, maximum))\n        value = int(value)\n    if not 0 <= seed <= 0xffffffff:\n        raise ValueError('--seed должен быть uint32: 0…4294967295')\n    if heads < 0 or tails < 0:\n        raise ValueError('--heads и --tails должны быть неотрицательными')\n    if heads + tails > 100000:\n        raise ValueError('Для учебного графика используйте не более 100000 исходов')\n    allowed = {'grid': ('A', 'B', 'intersection', 'union'),\n               'tree': ('A', 'AA', 'AB', 'BA', 'BB'),\n               'independent': ('A', 'coin', 'bag')}\n    if kind in allowed and mode not in allowed[kind]:\n        raise ValueError('--mode: ' + ', '.join(allowed[kind]))\n    return value\n\n\ndef model(idea, value=None, seed=42, heads=0, tails=0, mode='A'):\n    value = validate(idea, value, seed, heads, tails, mode)\n    kind, _, _, _, title = CONFIGS[idea]\n    result = {'idea': idea, 'kind': kind, 'title': title,\n              'parameters': {'value': value, 'seed': seed, 'heads': heads, 'tails': tails, 'mode': mode},\n              'metrics': {}, 'series': [], 'rows': [],\n              'note': 'Современная учебная реконструкция. Условия вероятностной модели существенны.'}\n    metrics, curves, rows = result['metrics'], result['series'], result['rows']\n\n    if kind == 'binomial':\n        values = binomial(value)\n        approximation = normal_mass(value) if idea in ('de-moivre', 'galton') else None\n        curves.append(series('Биномиальная вероятность', enumerate(values), 'bar'))\n        if approximation:\n            curves.append(series('Нормальная масса k±0,5', enumerate(approximation), color='#bc8754'))\n        for k, probability in enumerate(values):\n            row = {'k': k, 'probability': probability, 'paths': math.comb(value, k)}\n            if approximation:\n                row['normal_mass'] = approximation[k]\n            rows.append(row)\n        metrics.update(n=value, p=.5, mean=value / 2, variance=value / 4,\n                       total_probability=sum(values), total_paths=2 ** value,\n                       largest_path_count=math.comb(value, value // 2))\n        if approximation:\n            metrics['normal_mass_total_on_bins'] = sum(approximation)\n    elif kind == 'grid':\n        count = 0\n        for a in range(1, 7):\n            for b in range(1, 7):\n                event_a, event_b = a + b == 7, a % 2 == 0\n                selected = {'A': event_a, 'B': event_b, 'intersection': event_a and event_b,\n                            'union': event_a or event_b}[mode]\n                count += selected\n                rows.append({'a': a, 'b': b, 'A': event_a, 'B': event_b,\n                             'selected': selected, 'probability': 1 / 36})\n        metrics.update(selected_outcomes=count, all_outcomes=36, probability=count / 36)\n    elif kind == 'tree':\n        for path in ('AA', 'AB', 'BA', 'BB'):\n            rows.append({'path': path, 'winner': 'B' if path == 'BB' else 'A',\n                         'probability': .25, 'selected': path == mode})\n        curves.append(series('Вес продолжения', [(i, .25) for i in range(4)], 'bar'))\n        metrics.update(A_wins=.75, B_wins=.25, fair_share_ratio='3:1', selected_path=mode if len(mode) == 2 else None)\n    elif kind == 'expectation':\n        for i, payout in enumerate((0, 3, 12)):\n            rows.append({'outcome': i, 'payout': payout, 'probability': 1 / 3})\n        curves.append(series('Вероятность выплаты', [(payout, 1 / 3) for payout in (0, 3, 12)], 'scatter'))\n        for payout in (0, 3, 12):\n            curves.append(series('Выплата %s' % payout, [(payout, 0), (payout, 1 / 3)]))\n        curves.append(series('Ожидание E[X]=5', [(5, 0), (5, .4)], color='#bc8754'))\n        metrics['expectation'] = sum(row['payout'] * row['probability'] for row in rows)\n        result['note'] += ' По X — выплата, по Y — вероятность; пунктир при X=5 отмечает ожидание, а не исход.'\n    elif kind == 'denominator':\n        rows.extend([{'district': 'A', 'cases': 20, 'population': 200, 'rate': .1},\n                     {'district': 'B', 'cases': 20, 'population': value, 'rate': 20 / value}])\n        curves.append(series('Доля случаев', [(0, .1), (1, 20 / value)], 'bar'))\n        metrics.update(rate_A=.1, rate_B=20 / value)\n    elif kind == 'independent':\n        after = 0 if mode == 'bag' else .5\n        rows.extend([{'condition': 'before', 'probability': .5}, {'condition': 'after', 'probability': after}])\n        curves.append(series('Шанс второго красного / орла', [(0, .5), (1, after)], 'bar'))\n        metrics.update(before=.5, after=after, independent=mode != 'bag')\n    elif kind == 'lln':\n        random, count = XorShift32(seed), 0\n        for n in range(1, value + 1):\n            count += random() < .5\n            rows.append({'trial': n, 'heads': count, 'frequency': count / n})\n        curves.extend([series('Наблюдаемая частота', [(r['trial'], r['frequency']) for r in rows]),\n                       series('Вероятность', [(1, .5), (value, .5)], color='#bc8754')])\n        metrics.update(heads=count, trials=value, frequency=count / value)\n    elif kind == 'beta':\n        a, b = heads + 1, tails + 1\n        log_b = log_gamma(a) + log_gamma(b) - log_gamma(a + b)\n        points = []\n        for j in range(201):\n            theta = j / 200\n            # Браузер клипует вычислительную точку до .0001/.9999.\n            evaluated_theta = max(.0001, min(.9999, theta))\n            density = math.exp((a - 1) * math.log(evaluated_theta) + (b - 1) * math.log(1 - evaluated_theta) - log_b)\n            points.append((theta, density))\n            rows.append({'theta': theta, 'evaluation_theta': evaluated_theta, 'density': density})\n        mean = a / (a + b)\n        curves.extend([series('Плотность Beta', points),\n                       series('Среднее θ', [(mean, 0), (mean, max(y for _, y in points))], color='#bc8754')])\n        metrics.update(a=a, b=b, mean=mean)\n        result['note'] += ' Плотность в концах вычислена в .0001/.9999, как в браузере.'\n    elif kind in ('normal', 'student', 'mean', 'sumerrors'):\n        sd = value / 10 if kind == 'normal' else 1 / math.sqrt(value) if kind == 'mean' else math.sqrt(value) if kind == 'sumerrors' else 1\n        xmin = -10 if kind == 'sumerrors' else -3 if kind == 'mean' else -5\n        norm = [(xmin + (-2 * xmin) * j / 180, normal(xmin + (-2 * xmin) * j / 180, sd=sd)) for j in range(181)]\n        points = norm\n        if kind == 'student':\n            nu = value\n            constant = math.exp(log_gamma((nu + 1) / 2) - log_gamma(nu / 2)) / math.sqrt(nu * math.pi)\n            points = [(x, constant * (1 + x * x / nu) ** (-(nu + 1) / 2)) for x, _ in norm]\n            curves.append(series('Стандартная нормальная', norm, color='#bc8754'))\n            metrics['degrees_of_freedom'] = nu\n        elif kind == 'sumerrors':\n            curves.append(series('Один источник', [(x, normal(x)) for x, _ in norm], color='#bc8754'))\n        curves.insert(0, series('Плотность t' if kind == 'student' else 'Нормальная плотность', points))\n        for j, (x, density) in enumerate(points):\n            row = {'x': x, 'density': density}\n            if kind == 'student':\n                row['normal_density'] = norm[j][1]\n            elif kind == 'sumerrors':\n                row['single_error_density'] = normal(x)\n            rows.append(row)\n        if kind != 'student':\n            metrics.update(mean=0, sd=sd, variance=sd ** 2)\n    elif kind == 'dice':\n        values = [1.0]\n        for _ in range(value):\n            next_values = [0.0] * (len(values) + 5)\n            for i, probability in enumerate(values):\n                for face in range(6):\n                    next_values[i + face] += probability / 6\n            values = next_values\n        points = [(k + value, probability) for k, probability in enumerate(values)]\n        curves.append(series('Точная вероятность суммы', points, 'bar'))\n        rows.extend({'sum': k, 'probability': probability} for k,